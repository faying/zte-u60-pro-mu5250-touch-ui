#!/bin/sh /etc/rc.common
# procd service for u60-uid, the screen-owner daemon (src/uid.c): the only
# thing that starts/stops u60pro-devui and hands the panel to the vendor UI.
# Install to /etc/init.d/u60-uid; start from /etc/rc.local with
# `/etc/init.d/u60-uid start`, replacing the start.sh line (start.sh then
# leaves the UI alone, see uid_in_charge there).
#
# Runs in power-off charging too: the UI has its own charging screen there,
# exactly as start.sh used to launch it.
#
# `stop` leaves the UI on screen; the next start adopts it. To hand the screen
# to the vendor UI use `echo vendor > /tmp/u60-uid.ctl`, not `stop`.
# Do NOT run `enable`/`disable` (overlay whiteouts, manager CLAUDE.md).
# SPDX-License-Identifier: MIT

START=97
USE_PROCD=1

BIN=/data/plugins/u60pro-devui/u60-uid

start_service() {
    [ -x "$BIN" ] || return 1
    procd_open_instance
    procd_set_param command "$BIN"
    procd_set_param respawn 300 5 5  # see zte-agent.init for why 300
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
