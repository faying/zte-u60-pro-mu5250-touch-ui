#!/bin/sh /etc/rc.common
# procd service for u60-guard (Wi-Fi watchdog + alert SMS sender, see
# u60-guard.sh). Install to /etc/init.d/u60-guard and start it from
# /etc/rc.local with `/etc/init.d/u60-guard start`.
#
# Do NOT run `enable`/`disable`: /etc is an overlay on this device and those
# leave whiteouts in rc.d that outlive the service (manager CLAUDE.md).
# SPDX-License-Identifier: MIT

START=99
USE_PROCD=1

DIR=/data/u60-guard

# Same test as start.sh. In power-off charging the device is "off" to its
# owner: the agent does not run there, and a watchdog that noticed that would
# switch Wi-Fi on inside a switched-off device.
boot_is_normal() {
    _state=$(awk -F"'" '/option mode_main_state/ { print $2; exit }' /etc/config/zwrt_zte_mc_tmp 2>/dev/null)
    case "$_state" in
        mode_power_off_*) return 1 ;;
        mode_power_on | mode_power_on_charger) return 0 ;;
    esac
    grep -q 'silent_boot.mode=nonsilent' /proc/cmdline 2>/dev/null
}

start_service() {
    [ -f "$DIR/u60-guard.sh" ] && [ -f "$DIR/alert-lib.sh" ] || return 1
    boot_is_normal || return 0
    procd_open_instance
    procd_set_param command /bin/sh "$DIR/u60-guard.sh"
    procd_set_param respawn 300 5 5  # see zte-agent.init for why 300
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
